# Sensor wrappers pulled into src/ by `vcs import`.
# Run via `./scripts/setup.sh` — you should not need to run vcs by hand.
#
# Pin to tags/commits in production; branch refs are convenient during
# bring-up but make builds non-reproducible.
repositories:
  # last tested realsense-ros2 version: 6d87b071dcfef15f2a0407e1e78945256add70d0
  # Pinned past the 4.57.7 tag -- the 4.57.7 tag itself caused RealSense
  # issues on this hardware; this commit ("fix package.xml", tracked off
  # ros2-master) is the one confirmed working.
  realsense-ros:
    type: git
    url: https://github.com/realsenseai/realsense-ros.git
    version: 5c2244ca5cd9867c9ee63769668891430f460dfd
    # version: ros2-master
  ximea_ros2_cam:
    type: git
    url: https://github.com/hcmr-lab/ximea_ros2_cam.git
    version: main
  flir_boson_usb2:
    type: git
    url: https://github.com/hcmr-lab/flir_boson_usb2.git
    version: main
  # last tested ouster-ros2 version: 8570a92e776e8aa919e2250995c07c62810e9a65
  ouster-ros:
    type: git
    url: https://github.com/ouster-lidar/ouster-ros.git
    version: ros2
  norlab_xsens_driver:
    type: git
    url: https://github.com/hcmr-lab/norlab_xsens_driver.git
    version: humble
  xsens_mti_ros2:
    type: git
    url: https://github.com/xsenssupport/Xsens_MTi_ROS_Driver_and_Ntrip_Client.git
    version: ros2
  unilidar_sdk:
    type: git
    url: https://github.com/unitreerobotics/unilidar_sdk.git
    version: main
# ---------- Add your other sensor wrappers below ----------
#  package_name:
#    type: git
#    url: <link to git>
#    version: main or branch-name or tag
