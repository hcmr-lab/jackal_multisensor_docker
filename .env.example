# Template — `scripts/setup.sh` will auto-generate `.env` from your host user,
# so you typically don't need to copy this file manually. It's here for
# reference and for CI/non-interactive setups.

USER_NAME=ros2user
USER_UID=1000
USER_GID=1000
PLUGDEV_GID=46
VIDEO_GID=44
DIALOUT_GID=20

CONTAINER_NAME=multisensor_container

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/ros2user/config/cyclonedds.xml

# Jackal networking (used by start_bridge.sh)
JACKAL_IP=169.254.126.137
PC_IP=169.254.179.150
# Opt-in: route ROS 1 to a local master if the Jackal is unreachable,
# instead of retrying forever. See the Ros1_bridge section in README.md.
ALLOW_LOCALHOST_FALLBACK=false

# Colcon build parallel processes
PARALLEL_WORKERS=2
BUILD_JOBS=2