# Template — `scripts/setup.sh` will auto-generate `.env` from your host user,
# so you typically don't need to copy this file manually. It's here for
# reference and for CI/non-interactive setups.

USER_NAME=ros2user
USER_UID=1000
USER_GID=1000
PLUGDEV_GID=46
VIDEO_GID=44
DIALOUT_GID=20

CONTAINER_NAME=multisensor_container

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/ros2user/config/cyclonedds.xml

# Jackal networking (used by start_bridge.sh)
JACKAL_IP=169.254.126.137
PC_IP=169.254.179.150
# Opt-in: route ROS 1 to a local master if the Jackal is unreachable,
# instead of retrying forever. See docs/ros1_bridge.md.
ALLOW_LOCALHOST_FALLBACK=false

# Colcon build parallel processes
PARALLEL_WORKERS=2
BUILD_JOBS=2

# Commands run by scripts/stack.sh (`make stack` / `make record`) inside the container
SENSORS_LAUNCH_CMD='ros2 launch multisensor_bringup multisensor.launch.py launch_realsense:=false'
RECORD_CMD='ros2 bag record -s mcap -a -x ".*(compressed|theora).*" --max-bag-size 2147483648 --max-cache-size 209715200'
